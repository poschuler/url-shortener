{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "description": "A URL shortener built with Node.js, TypeScript and Fastify: a modular monolith with hexagonal architecture, used as a reference project.",
  "keywords": [
    "fastify",
    "hexagonal-architecture",
    "nodejs",
    "typescript",
    "url-shortener"
  ],
  "license": "MIT",
  "author": "poschuler",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test:coverage",
    "deps:check": "depcruise src",
    "dev": "tsx watch --env-file-if-exists=.env src/entrypoints/api.ts",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/entrypoints/api.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/entrypoints/migrate.ts",
    "db:migrate:down": "tsx --env-file-if-exists=.env src/entrypoints/migrate.ts down"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^6.2.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.3.36",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "^18.5.0",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rimraf": "^6.1.3",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0"
}
